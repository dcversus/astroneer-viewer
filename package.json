{
  "name": "astroneer-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dump": "node --experimental-strip-types --no-warnings scripts/dump.ts",
    "summary": "node --experimental-strip-types --no-warnings scripts/summary.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitepress": "^1.6.4"
  },
  "description": "Explore an Astroneer save in 3D: planets, bases, tethers, vehicles, deaths, research and missions, entirely in your browser.",
  "license": "GPL-3.0-only",
  "homepage": "https://dcversus.github.io/astroneer-viewer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcversus/astroneer-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/dcversus/astroneer-viewer/issues"
  },
  "keywords": [
    "astroneer",
    "savegame",
    "save-editor",
    "viewer",
    "3d",
    "threejs",
    "map",
    "unreal-engine",
    "gvas"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
